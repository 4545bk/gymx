{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next",
      "config": {
        "rootDirectory": "frontend"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://gymx-api.onrender.com/api/$1",
      "headers": {
        "x-forwarded-host": "$host"
      }
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
