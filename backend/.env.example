# ─── Required ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/gymx
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-jwt-secret-min-32-chars-long-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long-here
SCANNER_API_KEY=your-scanner-api-key-long-random-string
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ─── Optional ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
GYM_TIMEZONE=Africa/Addis_Ababa

# ─── Seed Script ──────────────────────────────────────────
SEED_OWNER_EMAIL=owner@gymx.com
SEED_OWNER_PASSWORD=OwnerPass123!
SEED_OWNER_NAME=Gym Owner
