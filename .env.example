# ─────────────────────────────────────────────────────────────
# GymX Environment Variables — Example
# Copy this to backend/.env and frontend/.env.local
# ─────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════
# BACKEND (backend/.env)
# ═══════════════════════════════════════════════════════════

# ─── Required ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/gymx
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-characters
SCANNER_API_KEY=your-scanner-api-key-for-qr-checkin
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ─── Optional ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
GYM_TIMEZONE=Africa/Addis_Ababa

# ─── Seed Script ──────────────────────────────────────────
SEED_OWNER_EMAIL=owner@gymx.com
SEED_OWNER_PASSWORD=OwnerPass123!
SEED_OWNER_NAME=Gym Owner

# ─── Cloudinary (Image Storage) ───────────────────────────
# Free tier: 25GB storage. Used for member photos & gym logo.
# Get credentials at https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ═══════════════════════════════════════════════════════════
# FRONTEND (frontend/.env.local)
# ═══════════════════════════════════════════════════════════

# Points to the backend API (used by next.config.js rewrites)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ═══════════════════════════════════════════════════════════
# PRODUCTION VALUES (examples)
# ═══════════════════════════════════════════════════════════

# Backend on Render:
# NEXT_PUBLIC_API_URL=https://gymx-api.onrender.com/api/v1

# MongoDB Atlas free tier:
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/gymx

# Upstash Redis free tier:
# REDIS_URL=rediss://default:xxx@us1-xxx.upstash.io:6379

# Generate secrets:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
